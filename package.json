{
  "name": "affiliatemachine",
  "private": true,
  "workspaces": ["apps/*", "packages/*", "domains/*"],
  "scripts": {
    "dev": "bun run --filter",
    "build": "bun run --filter",
    "lint": "eslint .",
    "format": "prettier --write .",
    "deploy:admin": "bun run --cwd apps/admin deploy",
    "deploy:admin-worker": "bun run --cwd apps/admin worker:deploy",
    "deploy:bilforsakringar": "bun run --cwd apps/bilforsakringar build && bunx wrangler pages deploy apps/bilforsakringar/dist --project-name=bilforsakringar",
    "deploy:bilforsakringar-worker": "bun run --cwd apps/bilforsakringar worker:deploy",
    "deploy:robotdammsugare": "bun run --cwd apps/robotdammsugare deploy",
    "deploy:elsparkcyklar": "bun run --cwd apps/elsparkcyklar deploy",
    "deploy:bastaelcykeln": "bun run --cwd apps/bastaelcykeln deploy",
    "deploy:all": "ops/deploy-all.sh",
    "deploy:check": "ops/deploy-all.sh --check"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "prettier": "^3.8.3",
    "eslint": "^9.39.4",
    "wrangler": "^4.93.0"
  }
}
