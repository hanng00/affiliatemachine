{
  "name": "solceller",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --outDir dist && vite build --ssr src/entry-server.tsx --outDir dist-server && bun prerender.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "bun run build && npx wrangler pages deploy dist --project-name=solceller && wrangler deploy",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@affiliate/analytics": "workspace:*",
    "@affiliate/seo": "workspace:*",
    "@affiliate/sites": "workspace:*",
    "@affiliate/solar-calculator": "workspace:*",
    "@turf/area": "^7.2.0",
    "@turf/helpers": "^7.2.0",
    "hono": "^4.7.10",
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-helmet-async": "^2.0.5",
    "react-router": "^7.6.1",
    "react-router-dom": "^7.6.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250514.0",
    "@tailwindcss/vite": "^4.1.7",
    "@types/leaflet": "^1.9.20",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vite": "^6.4.2",
    "wrangler": "^4.19.1"
  }
}
