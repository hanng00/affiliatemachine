# Google Maps Platform — Places API (New) key for the address search.
#
# Used client-side by src/lib/geocode.ts for autocomplete + place details.
# Because it ships in the browser bundle, lock it down in Google Cloud Console:
#   - Application restriction: HTTP referrers → your domain(s) (e.g. *.solkalkylatorn.se/*, *.pages.dev/*)
#   - API restriction: Places API (New) only
#
# If unset, the address search falls back to Nominatim (OpenStreetMap), free but
# weaker for small/partial Swedish addresses.
VITE_GOOGLE_MAPS_API_KEY=abc123
