    "@affiliate/analytics": "workspace:*",
    "@affiliate/mdx": "workspace:*",
    "@affiliate/seo": "workspace:*",
    "@affiliate/sites": "workspace:*",
    "@affiliate/ui": "workspace:*",
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-helmet-async": "^2.0.5",
    "react-router": "^7.6.1",
    "react-router-dom": "^7.6.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
