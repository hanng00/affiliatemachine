{
  "name": "elsparkcyklar",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --outDir dist && vite build --ssr src/entry-server.tsx --outDir dist-server && bun prerender.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "bun run build && npx wrangler pages deploy dist --project-name=elsparkcyklar --branch=production"
  },
